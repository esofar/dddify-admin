{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=dddify_admin;Username=app_user;Password=app_pwd"
  },
  "Redis": {
    "Configuration": "localhost:6379,password=app_pwd,abortConnect=false",
    "InstanceName": "dddify:"
  },
  "Jwt": {
    "Secret": "YourVeryStrongAndLongSecretKeyHere1234567890ABCDEF",
    "Issuer": "your_issuer",
    "Audience": "your_audience",
    "AccessTokenMinutes": 1,
    "RefreshTokenDays": 7
  },
  "SessionCleanup": {
    "IntervalMinutes": 60,
    "RevokedRetentionDays": 30,
    "RunOnStartup": false
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownIPNetworks": []
  },
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EmailVerificationCode": {
    "HashSecret": "",
    "ExpiresMinutes": 5,
    "CooldownSeconds": 60,
    "MaxSendsPerEmailPerHour": 5,
    "MaxSendsPerIpPerHour": 100,
    "MaxVerifyAttempts": 5
  },
  "Email": {
    "UseDevelopmentSender": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "From": "",
    "DisplayName": "Dddify Admin"
  }
}
