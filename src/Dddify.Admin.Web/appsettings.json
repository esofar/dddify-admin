{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=dddify_admin;Username=app_user;Password=app_pwd"
  },
  "Redis": {
    "Configuration": "localhost:6379,password=app_pwd,abortConnect=false",
    "InstanceName": "dddify:"
  },
  "Jwt": {
    "Secret": "YourVeryStrongAndLongSecretKeyHere1234567890ABCDEF",
    "Issuer": "your_issuer",
    "Audience": "your_audience",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "SessionCleanup": {
    "IntervalMinutes": 60,
    "RevokedRetentionDays": 30,
    "RunOnStartup": false
  },
  "Sms": {
    "DefaultProvider": "Fake",
    "FallbackEnabled": false,
    "FallbackProviders": [ "Fake", "Aliyun", "Tencent" ],
    "SignName": "Dddify Admin",
    "TimeoutSeconds": 3,
    "RetryCount": 1,
    "Templates": {
      "LoginCode": {
        "Content": "Your login verification code is {Code}. It expires in {Minutes} minutes.",
        "AliyunTemplateCode": "SMS_000000000",
        "TencentTemplateId": "000000",
        "ParameterOrder": [ "Code", "Minutes" ]
      }
    },
    "Verification": {
      "CodeLength": 6,
      "ExpiresMinutes": 5,
      "CooldownSeconds": 60,
      "MaxSendsPerWindow": 5,
      "SendWindowMinutes": 60,
      "MaxVerifyAttempts": 5,
      "VerifyWindowMinutes": 10,
      "LoginTemplateName": "LoginCode",
      "ReturnCodeInResponse": false,
      "HashSecret": "YourSmsCodeHashSecretHere1234567890ABCDEF"
    },
    "RateLimit": {
      "Enabled": true,
      "MaxSendsPerPhone": 20,
      "PerPhoneWindowSeconds": 3600,
      "MaxSendsPerIp": 100,
      "PerIpWindowSeconds": 3600
    },
    "Fake": {
      "LogMessageContent": true,
      "LatencyMilliseconds": 0
    },
    "Aliyun": {
      "AccessKeyId": "",
      "AccessKeySecret": "",
      "Endpoint": "dysmsapi.aliyuncs.com"
    },
    "Tencent": {
      "SecretId": "",
      "SecretKey": "",
      "Region": "ap-guangzhou",
      "Endpoint": "sms.tencentcloudapi.com",
      "SmsSdkAppId": ""
    }
  },
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
